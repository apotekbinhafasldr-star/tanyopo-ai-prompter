# Tanyopo AI Promoter — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# This app shares a Supabase project with UMKMpro AI. All Promoter tables
# are prefixed `prompter_`; see docs/DATABASE.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only — never expose to the client. Required for
# admin/webhook/background-job code paths (lib/supabase/admin.ts). Those
# paths render NOT_CONFIGURED and no-op safely if this is left empty.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI provider (required for Marketing Blueprint / Promote Wizard / -----
# Content Studio generation — Phase 1) ------------------------------------
# Business logic goes through lib/ai/provider.ts and never hard-codes a
# vendor. AI_PROVIDER_NAME defaults to "anthropic" when left blank but a
# key is set (lib/ai/get-provider.ts) — only Anthropic is implemented today.
# Leave both blank to keep AI generation features NOT_CONFIGURED.
AI_PROVIDER_NAME=
AI_PROVIDER_API_KEY=

# --- Meta (Facebook & Instagram) connector — optional, Phase 3 ---------
# Leave empty to keep the Meta connector in NOT_CONFIGURED state.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# --- TikTok connector — optional, Phase 6 -------------------------------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=

# --- X (Twitter) connector — optional, Phase 6 --------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# --- UMKMpro AI integration — optional, Phase 4 -------------------------
# Signed service token UMKMpro AI uses to call
# /api/v1/integrations/umkmpro/*. Generate and rotate independently of any
# user session.
UMKMPRO_SERVICE_TOKEN=
