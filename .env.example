# Tanyopo AI Promoter — environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (required) ---------------------------------------------------
# This app shares a Supabase project with UMKMpro AI. All Promoter tables
# are prefixed `prompter_`; see docs/DATABASE.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. Server-only — never expose to the client. Required for
# admin/webhook/background-job code paths (lib/supabase/admin.ts). Those
# paths render NOT_CONFIGURED and no-op safely if this is left empty.
SUPABASE_SECRET_KEY=

# --- App ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# B4 hotfix #3: a stable key for Next.js's Server Actions encryption
# (read directly by Next.js itself — process.env.NEXT_SERVER_ACTIONS_ENCRYPTION_KEY,
# no next.config.ts wiring). Without this, Next.js generates a random key
# per build and caches it under .next/cache; on a host that doesn't
# persist that cache across deploys (confirmed: this project's Netlify
# builds don't), every single deploy invalidates every Server Action
# reference baked into any page already open in a visitor's browser —
# any un-refreshed tab that then calls a Server Action gets Next's
# "Failed to find Server Action ... This request might be from an older
# or newer deployment" failure. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# then set it as a real (non-public) env var on every deploy target —
# changing it later invalidates action references again, so treat it
# like any other long-lived secret, not something to rotate casually.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- AI provider (required for Marketing Blueprint / Promote Wizard / -----
# Content Studio / SEO / Analytics / Optimization generation) -------------
# Business logic never calls a vendor SDK or picks a provider directly —
# every AI call goes through the Tanyopo AI Router (lib/ai/router.ts),
# which routes by task class (lib/ai/task-classes.ts: FAST/STANDARD/
# STRATEGY/CRITICAL). Set at least one of the two keys below to enable AI
# generation; leave both blank to keep it NOT_CONFIGURED. Setting only one
# key is enough — the router picks it automatically with no other config.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider serves a task class with no AI_<CLASS>_PROVIDER override
# below. Optional — if unset, the router uses whichever single key above
# is actually present. Only meaningful once both keys are set.
AI_DEFAULT_PROVIDER=

# Tried once, only on a live failure of the resolved primary provider.
# Optional — leave blank for no fallback (a failure just fails, it's
# never silently swallowed or faked as success).
AI_FALLBACK_PROVIDER=

# OpenAI has no hardcoded default model in this codebase (unlike
# Anthropic, which defaults to claude-opus-5) — a route that resolves to
# OpenAI with no model configured here (or per-class below) is treated as
# unusable rather than guessing an id. gpt-5.4-mini is the verified
# production default: confirmed live against this exact SDK/API path
# (openai package, client.responses.parse() + zodTextFormat structured
# output — lib/ai/openai-provider.ts) on 2026-09-01. Set this so a bare
# OPENAI_API_KEY is enough to use OpenAI for every task class, or set the
# four per-class AI_<CLASS>_MODEL vars below for finer control.
AI_OPENAI_DEFAULT_MODEL=

# Optional per-task-class overrides — e.g. a cheaper model for FAST,
# Anthropic for STRATEGY while OpenAI stays the default elsewhere.
# Leave any of these blank to use AI_DEFAULT_PROVIDER / the resolved
# provider's own default model.
AI_FAST_PROVIDER=
AI_FAST_MODEL=
AI_STANDARD_PROVIDER=
AI_STANDARD_MODEL=
AI_STRATEGY_PROVIDER=
AI_STRATEGY_MODEL=
AI_CRITICAL_PROVIDER=
AI_CRITICAL_MODEL=

# --- Token encryption — required to store any OAuth connection (Phase 3+) --
# 32 raw bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# OAuth tokens at rest (lib/crypto/token-cipher.ts) before they're written
# to prompter_oauth_credentials — a table that has RLS enabled with zero
# app-level policies, so only the server (with this key) can ever read a
# token back.
# If this is empty or not 32 bytes after base64 decoding, "Connect" is
# refused BEFORE redirecting to Meta/TikTok/X (and again before the
# authorization code is exchanged in the callback), the owner sees an
# "encryption not configured" message, and no connection row is written.
# Do not change or rotate this key while connections exist: tokens already
# stored cannot be decrypted with a different key (the owner must
# reconnect). Never commit the real value.
TOKEN_ENCRYPTION_KEY=

# --- Meta (Facebook & Instagram) connector — optional, Phase 3 ---------
# Leave empty to keep the Meta connector in NOT_CONFIGURED state.
# Redirect URI must exactly match what's registered in the Meta App
# dashboard, e.g. https://yourapp.com/api/connections/meta/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Facebook Login for Business "Configuration ID" (Meta App Dashboard →
# Facebook Login for Business → Configurations). Optional, server-side only,
# NOT a secret — but it is per-Meta-app configuration, so set it per
# environment instead of hardcoding it. When set, the login dialog uses
# config_id (permissions come from that configuration, so `scope` is not
# sent). When empty, the classic scope-based dialog is used. Must be numeric;
# anything else makes Connect refuse with "connector not configured".
META_LOGIN_CONFIG_ID=

# --- TikTok connector — optional, Phase 6 -------------------------------
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=

# --- X (Twitter) connector — optional, Phase 6 --------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=

# --- UMKMpro AI integration — optional, Phase 4 -------------------------
# Signed service token UMKMpro AI uses to call
# /api/v1/integrations/umkmpro/*. Generate and rotate independently of any
# user session.
UMKMPRO_SERVICE_TOKEN=

# --- Payment provider — optional, provider-neutral -----------------------
# lib/billing/get-payment-provider.ts returns NullPaymentProvider unless
# PAYMENT_PROVIDER_NAME is "midtrans" (SANDBOX ONLY: PAYMENT_PROVIDER_API_KEY
# must be a Midtrans sandbox server key "SB-Mid-server-..."; a production key
# is refused) or "xendit" (sandbox). For Midtrans the server key is also the
# webhook signing key, so PAYMENT_PROVIDER_WEBHOOK_SECRET is not used. Set these
# ONLY in the hosting provider's server-side environment, never in code or chat. Leave all three blank to keep
# billing_provider/success_fee_rate_bps NOT_CONFIGURED — /billing renders
# that honestly, no invented price or fake "active" subscription.
PAYMENT_PROVIDER_NAME=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# --- Preview Basic-Auth — optional, non-production only -------------------
# Batch B11 hotfix. proxy.ts gates every non-public route behind Basic-Auth
# when BOTH are set — leave blank everywhere except a Netlify "Deploy
# Preview" context (never production) where Team Login/SSO protection had
# to be turned off to let a payment provider's webhook callback through.
PREVIEW_BASIC_AUTH_USER=
PREVIEW_BASIC_AUTH_PASSWORD=

# --- Background job processor — optional ---------------------------------
# Bearer secret app/api/internal/jobs/process/route.ts requires to claim
# and run due jobs. Leave blank to keep that endpoint NOT_CONFIGURED. Even
# once set, nothing in this app calls it on a schedule — an external
# scheduler (Vercel Cron, pg_cron, ...) must be configured separately to
# actually drive production queue execution.
JOBS_PROCESSOR_SECRET=

# --- LINOE Demo Environment — optional -------------------------------------
# Signs the isolated per-session demo token (lib/demo/session.ts). Leave
# blank to keep every /demo entry point NOT_CONFIGURED (redirects "Coba
# Demo" back to "/" with ?demo=unavailable) rather than ever falling back
# to a guessable default secret. Generate independently of every other
# secret above — this token grants no access to any real tenant, account,
# or credential, only to the sandboxed demo experience itself.
DEMO_SESSION_SECRET=

# --- Admin Center (Phase B) -----------------------------------------------
# Master switch for /admin and the "Admin Perusahaan" button. OFF unless this is
# exactly "true". Leave unset in production until the finance migrations are approved
# and applied and the first Super Admin row has been seeded.
ADMIN_CENTER_ENABLED=

# --- B4.2 payment alert e-mails (Netlify Scheduled Function, OFF by default) -------------------
# Nothing is sent unless ALERT_EMAIL_ENABLED is exactly "true". Set these ONLY in the Netlify environment, never in git.
# Recipients are never configured here: they are the active operators (prompter_payment_operators, by user id).
ALERT_EMAIL_ENABLED=false
# DRY RUN IS THE DEFAULT. A real e-mail needs ALERT_EMAIL_ENABLED=true AND ALERT_EMAIL_DRY_RUN=false (exact strings).
# Anything else (empty, true, 1, a typo) = read-only preview (counts only), no claim, no e-mail.
ALERT_EMAIL_DRY_RUN=true
# verified sender on the Resend domain, e.g. "LINOE Alerts <alerts@your-domain>"
ALERT_EMAIL_FROM=
# dedicated Resend API key (sending access only), separate from the Supabase Auth SMTP key
RESEND_ALERT_API_KEY=
# https base URL used for the "open the queue" link, e.g. https://your-app-domain
ALERT_EMAIL_LINK_BASE=
# optional, 1..20 (never above 20)
ALERT_EMAIL_DAILY_LIMIT=
